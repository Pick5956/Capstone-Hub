# ─────────────────────────────────────────────────────────────
# Restaurant Hub — Production Environment Template
# Copy this to .env and fill in actual values.
# Used by both docker-compose.yml and go run main.go.
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# When using Docker Compose, DB_HOST should be "pgbouncer" and
# DB_PORT should be "6432". For direct PostgreSQL, use "localhost:5432".
DB_HOST=pgbouncer
DB_PORT=6432
DB_USER=postgres
DB_PASSWORD=<secure-password>
DB_NAME=Project_M

# ── Connection Pool (Go application level) ───────────────────
# These control the Go database/sql connection pool.
# PgBouncer handles the actual PG connection multiplexing.
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME_MIN=30
DB_CONN_MAX_IDLE_TIME_MIN=5

# ── Server ───────────────────────────────────────────────────
GIN_MODE=release
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=<secure-random-string-at-least-64-chars>

# ── CORS / Frontend ─────────────────────────────────────────
FRONTEND_URL=https://dishy.pro
CORS_ALLOWED_ORIGINS=https://dishy.pro,https://www.dishy.pro

# ── Google OAuth (optional) ──────────────────────────────────
GOOGLE_CLIENT_ID=

# ── AI providers (optional) ─────────────────────────────────────
AI_PROVIDER=auto
AI_CONVERSATION_MEMORY_ENABLED=false
AI_ORCHESTRATOR_MODE=legacy
AI_ACTIONS_ENABLED=false
AI_ACTIONS_ALLOWED_RESTAURANT_IDS=
AI_OBSERVABILITY_ENABLED=false
AI_DAILY_REQUEST_BUDGET=0
AI_DAILY_TOKEN_BUDGET=0
AI_LATENCY_WARN_MS=5000
# ===== คีย์ AI =====================================================
# ใส่ได้หลายคีย์ คั่นด้วยจุลภาค เขียนบรรทัดละคีย์ในเครื่องหมายคำพูดได้
# เพิ่มคีย์: เติมอีกบรรทัด ปิดท้ายด้วยจุลภาค แล้ว restart backend
# ลบคีย์:   ลบทั้งบรรทัด (บรรทัดว่างและจุลภาคเกินถูกข้ามอัตโนมัติ)
# ห้ามใส่ # คอมเมนต์ในเครื่องหมายคำพูด เพราะจะกลายเป็นส่วนหนึ่งของคีย์
#
# ระบบหมุนใช้ทีละคีย์ พอคีย์ไหนโดน rate limit จะพักคีย์นั้นแล้วสลับตัวถัดไป
# ยิ่งมีคีย์มาก ยิ่งรับคำถามพร้อมกันได้มาก (1 คำถาม = เรียกโมเดล 2-4 ครั้ง)
GROQ_API_KEYS="
  gsk_ใส่คีย์ที่หนึ่งตรงนี้,
  gsk_ใส่คีย์ที่สองตรงนี้,
"
GROQ_MODEL=openai/gpt-oss-20b
GROQ_PLANNER_MODEL=openai/gpt-oss-20b

# ใช้เมื่อ AI_PROVIDER=auto หรือ gemini เท่านั้น (auto = Groq ก่อน แล้วค่อย Gemini)
GEMINI_API_KEYS="
  ใส่คีย์ Gemini ตรงนี้,
"
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_PLANNER_MODEL=gemini-3.5-flash-lite
