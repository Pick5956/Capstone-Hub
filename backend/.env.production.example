# ─────────────────────────────────────────────────────────────
# Restaurant Hub — Production Environment Template
# Copy this to .env and fill in actual values.
# Used by both docker-compose.yml and go run main.go.
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# When using Docker Compose, DB_HOST should be "pgbouncer" and
# DB_PORT should be "6432". For direct PostgreSQL, use "localhost:5432".
DB_HOST=pgbouncer
DB_PORT=6432
DB_USER=postgres
DB_PASSWORD=<secure-password>
DB_NAME=Project_M

# ── Connection Pool (Go application level) ───────────────────
# These control the Go database/sql connection pool.
# PgBouncer handles the actual PG connection multiplexing.
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME_MIN=30
DB_CONN_MAX_IDLE_TIME_MIN=5

# ── Server ───────────────────────────────────────────────────
GIN_MODE=release
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=<secure-random-string-at-least-64-chars>

# ── CORS / Frontend ─────────────────────────────────────────
FRONTEND_URL=https://dishy.pro
CORS_ALLOWED_ORIGINS=https://dishy.pro,https://www.dishy.pro

# ── Google OAuth (optional) ──────────────────────────────────
GOOGLE_CLIENT_ID=

# ── AI providers (optional) ─────────────────────────────────────
AI_PROVIDER=auto
AI_CONVERSATION_MEMORY_ENABLED=false
AI_ORCHESTRATOR_MODE=legacy
AI_ACTIONS_ENABLED=false
AI_ACTIONS_ALLOWED_RESTAURANT_IDS=
AI_OBSERVABILITY_ENABLED=false
AI_DAILY_REQUEST_BUDGET=0
AI_DAILY_TOKEN_BUDGET=0
AI_LATENCY_WARN_MS=5000
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_PLANNER_MODEL=openai/gpt-oss-20b
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PLANNER_MODEL=gemini-2.5-flash
